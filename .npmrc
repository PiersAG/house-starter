# Supply-chain hardening (card 2.3.4).
#
# ignore-scripts=true stops npm executing preinstall/install/postinstall
# lifecycle scripts from dependencies. That is the single highest-value npm
# control available: in the npm worm incidents of 2025-26 the malicious payload
# ran at INSTALL time, before any human read a line of the package. With this
# set, a compromised dependency has to wait to be imported and executed rather
# than owning the machine the moment it lands.
#
# It applies to THIS project's own scripts too — npm's documented behaviour is
# "npm does not run scripts specified in package.json files", not "dependency
# scripts only". So `npm install` no longer runs our own `prepare` (husky).
# The explicit path is preserved and documented:
#
#   npm ci && npm run prepare
#
# `npm run <name>` still executes its named script under ignore-scripts (only
# pre/post hooks are suppressed), so `npm run prepare` remains the supported way
# to install git hooks after a clone. The hooks are NOT disabled — see
# package.json "prepare" and README.
#
# CI does not need hooks, so ci.yml deliberately does not call it.
ignore-scripts=true
