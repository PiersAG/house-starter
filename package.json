{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "check:colours": "node scripts/check-hardcoded-colours.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:isolation": "vitest run tests/unit/db.test.ts tests/unit/isolation-route-coverage.test.ts && playwright test --project=isolation",
    "test:responsive": "playwright test --project=responsive-320-small-phone --project=responsive-390-phone --project=responsive-768-tablet --project=responsive-1280-laptop --project=responsive-1920-desktop",
    "test:layout": "playwright test --project=layout-guardrail",
    "test:layout:update": "playwright test --project=layout-guardrail --update-snapshots",
    "operator:setting": "tsx scripts/set-operator-setting.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:all-tenants": "tsx scripts/migrate-all-tenants.ts",
    "db:verify-tenant-backups": "tsx scripts/verify-tenant-backups.ts",
    "db:reseal-secrets": "tsx scripts/reseal-secrets.ts",
    "db:push": "drizzle-kit push",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "otplib": "13.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "stripe": "22.6.2",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "10.6.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "15.5.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "8.3.4",
    "form-data": "4.0.6",
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "nanoid": "3.3.20"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  }
}
