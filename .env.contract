# Declared env vars required at build/deploy time — the SINGLE authority
# (F14 / Systemic Rec 1). safe-env-deploy.yml checks this after clone and
# fails before `vercel deploy` if it disagrees with what the deploy injects;
# verify-repo-manifest.py asserts it is complete at scaffold; launcher.py
# reads the secret-source names; instrumentation.ts validates the running
# environment against it at boot. Keep in sync with
# agents/build/env_contract.py CANONICAL_INJECTED.
#
# Format: NAME=source
#   secret    value comes from a CI secret, injected at deploy time
#   generated value generated per deploy (session secret, per-run preview DB)
#   fixed     deploy injects a constant for the safe-env preview
#   app       app supplies its own; appended by the app's scaffold step
#   infra     deploy-tooling credential (Vercel CLI); not injected into app env
VERCEL_TOKEN=infra
VERCEL_ORG_ID=infra
AUTH_SECRET=generated
STRIPE_SECRET_KEY=secret
STRIPE_WEBHOOK_SECRET=secret
DATABASE_URL=generated
DATABASE_AUTH_TOKEN=generated
TENANCY_MODE=fixed
# ADR-023 per-tenant routing. The CATALOG is the control-plane database (accounts,
# sessions, billing, the tenant registry); it falls back to DATABASE_URL when not
# named separately, which is what the preview deploy relies on — so these two are
# `app`, set only when an app wants its catalog on its own database.
CATALOG_DATABASE_URL=app
CATALOG_DATABASE_AUTH_TOKEN=app
# Tenant provisioning (ADR-023). `app` source, NOT deploy-injected-required:
# every var with a secret/generated/fixed source is asserted present at BOOT by
# instrumentation.ts, and these four must not be, or no local dev server, CI run
# or isolation harness could start without Turso credentials. A deployed
# environment (VERCEL_ENV set) selects the Turso provisioner and safe-env-deploy
# injects all four; if they were somehow absent there, sign-up fails loudly
# rather than silently writing a customer's database to an ephemeral disk —
# see lib/tenant/provisioner.ts, and the pre-deploy guard in safe-env-deploy.yml.
#
#   TENANT_PROVISIONER  "turso" | "file" — explicit override of the selection.
#   TURSO_API_TOKEN     the app's own Turso token: scopes db:create, db:mint-token
#                       and read, limited to the app's group (factory
#                       agents/turso_app_group.py). No delete right: a customer
#                       database is deleted by the factory's erase job.
#   TURSO_ORG           Turso organisation slug.
#   APP_SLUG            prefix of each tenant's hosted database name,
#                       `<app-slug>-<tenant-id>` — how
#                       scripts/verify-tenant-backups.ts finds this app's
#                       tenant databases in the org.
TENANT_PROVISIONER=app
TURSO_API_TOKEN=app
TURSO_ORG=app
APP_SLUG=app
# Canonical base URL for links the app SENDS OUT (password-reset emails and
# anything else identity-bearing). `app` source and NOT boot-required: on Vercel
# the platform's own VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL already give a
# trustworthy server-side answer, so nothing has to be configured for a deploy
# to be correct — see lib/app-url.ts. Set it when the app has a custom domain,
# so the links carry that domain rather than the deployment hostname.
APP_CANONICAL_URL=app
APP_LIFECYCLE_STATE=fixed
RATE_LIMIT_ALLOW_IN_MEMORY=fixed
# Shared rate-limit store (an Upstash-compatible Redis REST endpoint). `secret`
# source, so safe-env-deploy MUST inject both or the contract check fails the
# deploy before it happens — which is the point: a deployed instance without a
# shared store enforces its rate limits on a per-instance counter that resets on
# every cold start, i.e. not at all. lib/rate-limit.ts refuses to build the
# in-memory stand-in when VERCEL_ENV is set, and instrumentation.ts requires
# these two at boot under the SAME condition, so local dev, CI and the isolation
# harness — which set no VERCEL_ENV — still start without them.
RATE_LIMIT_STORE_URL=secret
RATE_LIMIT_STORE_TOKEN=secret
EMAIL_PROVIDER_API_KEY=secret
EMAIL_FROM=app
EMAIL_SEND_MODE=fixed
# Transactional email (app-business-core issues 470, 757; docs/email.md). `app`
# source, not boot-required: log mode (CI, previews) needs none of them, and a
# live app missing any of them shows a red `email` check on /api/health.
#   EMAIL_PROVIDER         which provider sends ("resend" when unset).
#   EMAIL_SENDING_DOMAIN   the subdomain kept for transactional mail; EMAIL_FROM
#                          must send from it (lib/email/sending-domain.ts).
#   EMAIL_MARKETING_DOMAIN optional; must not be the sending domain.
#   EMAIL_EVENTS_SECRET    signs the provider's delivery reports to
#                          /api/email/events (the provider shows it once).
EMAIL_PROVIDER=app
EMAIL_SENDING_DOMAIN=app
EMAIL_MARKETING_DOMAIN=app
EMAIL_EVENTS_SECRET=app
# Factory owner account address (v0-owner-account-seed). When present, the
# migration seeds this owner account + a never-expiring owner grant, idempotently.
# `app` source: not boot-required, so the seed is a safe no-op when unset (dev/CI).
OWNER_EMAIL=app
# SEC.15 MFA. Base64 32-byte key that seals each owner's authenticator secret at
# rest (lib/crypto/secret-box.ts). `secret` source: generated ONCE per app by
# provision-app-secrets (openssl rand -base64 32) and injected unchanged into
# every deploy. NEVER regenerated per deploy and never rotated automatically —
# a new key makes every enrolled authenticator unreadable (recovery codes are
# hashes and keep working, but each use spends one). Boot-required.
MFA_ENCRYPTION_KEY=secret
# Account deletion and retention (app-business-core issues 722, 791). The secret
# Vercel's scheduler sends to /api/cron/retention (vercel.json `crons`). `app`
# source and not boot-required: without it the route refuses (503), the daily
# job does not run, and /api/health's `deletions` check turns red once an
# erasure is 72 hours late. Generate once per app: openssl rand -base64 32.
CRON_SECRET=app
# Error tracking with Sentry (app-business-core issue 761; decision 700: the EU
# region). `app` source, not boot-required: with it unset, or not an EU address
# (https://<key>@o<org>.ingest.de.sentry.io/<project>), nothing is sent and
# nothing breaks; /api/health shows a non-critical `error_tracking` check while
# the switch in config/error-tracking.ts is on. Not secret (Sentry's "public
# key"); the CEO copies it from the app's Sentry project at the rebuild.
SENTRY_DSN=app
